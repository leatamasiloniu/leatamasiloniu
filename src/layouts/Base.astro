---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** path of this page in the other language */
  alt: string;
  current?: PageKey;
  title?: string;
  description?: string;
}

const defaults = {
  en: {
    title: 'Lea Tămășiloniu Studio | Consultancy for growing businesses',
    description: 'Lea Tămășiloniu Studio helps growing businesses see what’s holding them back and build the structure to move forward: strategy, systems, projects and events.',
  },
  ro: {
    title: 'Lea Tămășiloniu Studio | Consultanță pentru afaceri în creștere',
    description: 'Lea Tămășiloniu Studio ajută afacerile în creștere să vadă ce le ține pe loc și să construiască structura de care au nevoie: strategie, sisteme, proiecte și evenimente.',
  },
};

const { lang, alt, current } = Astro.props;
const title = Astro.props.title ?? defaults[lang].title;
const description = Astro.props.description ?? defaults[lang].description;
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), Astro.site);
const altUrl = new URL(alt, Astro.site);
const enUrl = lang === 'en' ? canonical : altUrl;
const roUrl = lang === 'ro' ? canonical : altUrl;
const ogImage = new URL('/og.png', Astro.site);

// Structured data: tells search engines who Lea is and what the studio offers.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://www.leatamasiloniu.com/#lea',
      name: 'Lea Tămășiloniu',
      jobTitle: lang === 'en' ? 'Consultant' : 'Consultant',
      url: 'https://www.leatamasiloniu.com/',
      sameAs: ['https://www.linkedin.com/in/lea-tamasiloniu', 'https://www.instagram.com/leatamasiloniustudio/'],
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'University of the Arts London' },
      knowsLanguage: ['en', 'ro'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': 'https://www.leatamasiloniu.com/#studio',
      name: 'Lea Tămășiloniu Studio',
      url: 'https://www.leatamasiloniu.com/',
      email: 'info@leatamasiloniu.com',
      founder: { '@id': 'https://www.leatamasiloniu.com/#lea' },
      description: defaults[lang].description,
      areaServed: ['United Kingdom', 'Europe'],
      serviceType: lang === 'en'
        ? ['Operations consultancy', 'Systems and SOPs', 'Event planning and delivery', 'Business advisory']
        : ['Consultanță operațională', 'Sisteme și proceduri', 'Planificare și organizare de evenimente', 'Consultanță de afaceri'],
    },
  ],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ro" href={roUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFCFA" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'ro_RO'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} alt={alt} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <button class="to-top" type="button" aria-label={ui[lang].toTop} title={ui[lang].toTop} hidden>
      <span aria-hidden="true">↑</span>
    </button>
    <script>
      // Gentle fade-up as sections enter the screen. Skipped for reduced-motion users.
      const revealEls = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        revealEls.forEach((el) => io.observe(el));
      }

      const topBtn = document.querySelector<HTMLButtonElement>('.to-top');
      if (topBtn) {
        const toggle = () => { topBtn.hidden = window.scrollY < window.innerHeight; };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        topBtn.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          document.querySelector<HTMLElement>('.site-header a')?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
