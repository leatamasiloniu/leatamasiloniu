---
import '@fontsource-variable/bodoni-moda/opsz.css';
import '@fontsource-variable/bodoni-moda/opsz-italic.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, type Lang, type PageKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** path of this page in the other language */
  alt: string;
  current?: PageKey;
  title?: string;
  description?: string;
}

const defaults = {
  en: {
    title: 'Lea Tămășiloniu Studio | Strategy & structure for growing businesses',
    description: 'Lea Tămășiloniu Studio helps growing businesses see what’s holding them back and build the structure to move forward: strategy, systems, projects and events.',
  },
  ro: {
    title: 'Lea Tămășiloniu Studio | Strategie și structură pentru afaceri în creștere',
    description: 'Lea Tămășiloniu Studio ajută afacerile în creștere să vadă ce le ține pe loc și să construiască structura de care au nevoie: strategie, sisteme, proiecte și evenimente.',
  },
};

const { lang, alt, current } = Astro.props;
const title = Astro.props.title ?? defaults[lang].title;
const description = Astro.props.description ?? defaults[lang].description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(alt, Astro.site);
const enUrl = lang === 'en' ? canonical : altUrl;
const roUrl = lang === 'ro' ? canonical : altUrl;
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="ro" href={roUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FFFCFA" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'ro_RO'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">{ui[lang].skip}</a>
    <Header lang={lang} alt={alt} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <button class="to-top" type="button" aria-label={ui[lang].toTop} title={ui[lang].toTop} hidden>
      <span aria-hidden="true">↑</span>
    </button>
    <script>
      const topBtn = document.querySelector<HTMLButtonElement>('.to-top');
      if (topBtn) {
        const toggle = () => { topBtn.hidden = window.scrollY < window.innerHeight; };
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
        topBtn.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
          document.querySelector<HTMLElement>('.site-header a')?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
