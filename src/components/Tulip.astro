---
// "Lalea" — tulip in Romanian: la + Lea. Hand-drawn in the engraved style of the LT monogram.
// Colours come from CSS: `color` for the ink, `--tulip-ground` for the paper behind the centre petal.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<svg class={className} viewBox="0 0 200 300" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="tl-hz" width="6" height="3.6" patternUnits="userSpaceOnUse">
      <rect width="6" height="1.25" fill="currentColor"></rect>
    </pattern>
    <pattern id="tl-dl" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(-40)">
      <rect width="4" height="1.2" fill="currentColor"></rect>
    </pattern>
    <pattern id="tl-dr" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(40)">
      <rect width="4" height="1.2" fill="currentColor"></rect>
    </pattern>
  </defs>
  <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round">
    <path d="M97.5 298 C95.5 262 97 222 98.5 184 L101.5 184 C103 222 104.5 262 102.5 298 Z" fill="currentColor" stroke-width="1"></path>
    <path d="M99 292 C86 262 60 238 46 200 C38 178 36 160 44 150 C52 140 64 148 60 160 C57 168 48 166 49 158 C58 196 84 226 100 262 Z" fill="url(#tl-dl)"></path>
    <path d="M99 290 C88 262 66 236 54 202 C66 230 86 252 100 272 Z" fill="currentColor" stroke="none"></path>
    <path d="M101 288 C116 258 146 240 156 212 C162 196 158 184 148 186 C139 188 140 201 149 201 C154 201 156 196 153 193 C140 226 116 244 100 262 Z" fill="url(#tl-dr)"></path>
    <path d="M101 286 C114 260 138 244 150 220 C140 244 118 258 100 272 Z" fill="currentColor" stroke="none"></path>
    <path d="M100 180 C66 180 46 158 46 122 C46 94 52 66 60 40 C66 52 76 62 84 72 C92 86 97 100 99 112 Z" fill="url(#tl-hz)"></path>
    <path d="M100 180 C134 180 154 158 154 122 C154 94 148 66 140 40 C134 52 124 62 116 72 C108 86 103 100 101 112 Z" fill="url(#tl-hz)"></path>
    <path d="M100 184 C74 176 66 146 68 112 C70 80 84 50 100 22 C116 50 130 80 132 112 C134 146 126 176 100 184 Z" fill="var(--tulip-ground, #FFFCFA)" stroke-width="2.8"></path>
    <path d="M100 184 C74 176 66 146 68 112 C70 80 84 50 100 22 C92 58 88 94 90 126 C91 152 95 172 100 184 Z" fill="currentColor" stroke="none"></path>
    <path d="M100 184 C126 176 134 146 132 112 C130 80 116 50 100 22 C108 60 113 96 113 128 C113 156 108 174 100 184 Z" fill="url(#tl-hz)" stroke="none"></path>
    <path d="M105 44 C110 74 112 104 110 136" stroke-width="1"></path>
    <path d="M89 184 C93 179 107 179 111 184 C107 190 93 190 89 184 Z" fill="currentColor"></path>
  </g>
</svg>
