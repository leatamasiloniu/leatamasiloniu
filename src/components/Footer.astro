---
import Tulip from './Tulip.astro';
import { ui, path, type Lang } from '../i18n/ui';
import { INSTAGRAM, LINKEDIN } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const year = new Date().getFullYear();
// Set like a dictionary entry: the headword split as la·lea.
const note = {
  en: { label: 'Tulip', pos: 'noun, Romanian', def: 'tulip.' },
  ro: { label: 'Lalea', pos: 's.f.', def: 'floare în formă de cupă.' },
}[lang];
---
<div class="checker footer-checker" aria-hidden="true"></div>
<footer id="contact-info" class="site-footer">
  <div class="columns">
    <div class="col">
      <p class="head">{t.footer.contact}</p>
      <a href={path(lang, 'contact')}>{t.cta.a} <span aria-hidden="true">→</span></a>
    </div>
    <div class="col">
      <p class="head">{t.footer.follow}</p>
      <a class="caps" href={INSTAGRAM} rel="noopener" target="_blank">Instagram</a>
      <a class="caps" href={LINKEDIN} rel="noopener" target="_blank">LinkedIn</a>
    </div>
    <div class="col">
      <p class="head">{t.footer.studio}</p>
      <p>{t.footer.studioLine}</p>
    </div>
    <div class="col end">
      <p class="head">{t.footer.availability}</p>
      <p class="avail"><span class="dot" aria-hidden="true"></span>{t.available}</p>
    </div>
  </div>

  <div class="initials">
    <span class="serif" aria-hidden="true">L</span>
    <button type="button" class="tulip" aria-describedby="tulip-note" aria-label={note.label}>
      <Tulip />
      <span id="tulip-note" class="tulip-note" role="tooltip">
        <span class="entry"><em class="serif">la·lea</em> <span class="pos">{note.pos}</span></span>
        <span class="def">{note.def}</span>
      </span>
    </button>
    <span class="serif" aria-hidden="true">T</span>
  </div>

  <div class="base">
    <span>© {year}</span>
  </div>
</footer>

<script>
  // On touch screens there is no hover: a tap shows or hides the note.
  document.querySelectorAll<HTMLButtonElement>('button.tulip').forEach((b) => {
    b.addEventListener('click', () => b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true')));
    b.addEventListener('blur', () => b.setAttribute('aria-expanded', 'false'));
  });
</script>

<style>
  .footer-checker {
    --checker-a: var(--blush);
    --checker-b: var(--chocolate);
  }

  .site-footer {
    background: var(--chocolate);
    color: var(--blush);
    padding: 64px clamp(20px, 3.9vw, 56px) 36px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 10vw, 150px);
    --tulip-ground: var(--chocolate);
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    border-top: 1px solid var(--blush);
    padding-top: 24px;
    font-size: 15px;
    line-height: 1.6;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .col.end {
    align-items: flex-end;
    text-align: right;
  }

  .head {
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .caps {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .avail {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .avail .dot {
    background: #7fb99c;
  }

  .initials {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .initials > .serif {
    font-size: clamp(150px, 30vw, 430px);
    line-height: 0.74;
  }

  /* the tulip stands as tall as the capitals, centred between them */
  .tulip {
    flex-shrink: 0;
    display: block;
    height: clamp(66px, 13vw, 190px);
    color: var(--blush);
  }

  .tulip {
    position: relative;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
  }

  .tulip-note {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 18px);
    transform: translate(-50%, 6px);
    width: max-content;
    max-width: 230px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    padding: 12px 18px 13px;
    background: var(--blush);
    color: var(--chocolate);
    text-align: left;
    font-size: 13px;
    line-height: 1.4;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .tulip-note .entry {
    display: flex;
    align-items: baseline;
    gap: 10px;
    white-space: nowrap;
  }

  .tulip-note em {
    font-style: italic;
    font-size: 21px;
    line-height: 1.2;
  }

  .tulip-note .pos {
    font-family: var(--serif);
    font-size: 13px;
    font-style: italic;
    color: var(--cocoa);
  }

  .tulip-note .def {
    font-weight: 300;
  }

  .tulip-note::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    margin-left: -6px;
    border: 6px solid transparent;
    border-top-color: var(--blush);
  }

  .tulip:hover .tulip-note,
  .tulip:focus-visible .tulip-note,
  .tulip[aria-expanded='true'] .tulip-note {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tulip-note {
      transition: none;
    }
  }

  .tulip :global(svg) {
    display: block;
    height: 100%;
    width: auto;
  }

  .base {
    font-size: 13px;
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 900px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }

    .col.end {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
