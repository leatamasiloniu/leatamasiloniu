---
const year = new Date().getFullYear();
---
<div class="checker footer-checker" aria-hidden="true"></div>
<footer id="contact" class="site-footer">
  <div class="columns">
    <div class="col">
      <p class="head">Contact</p>
      <a href="mailto:lea@leatamasiloniu.com">lea@leatamasiloniu.com</a>
    </div>
    <div class="col">
      <p class="head">Follow</p>
      <a class="caps" href="https://www.linkedin.com/in/lea-tamasiloniu" rel="noopener" target="_blank">LinkedIn</a>
    </div>
    <div class="col">
      <p class="head">Studio</p>
      <p>Working with clients in London and across Europe</p>
    </div>
    <div class="col end">
      <p class="head">Availability</p>
      <p class="avail"><span class="dot" aria-hidden="true"></span>Taking on select projects</p>
    </div>
  </div>

  <div class="initials" aria-hidden="true">
    <span class="serif">L</span>
    <span class="bullet"></span>
    <span class="serif">T</span>
  </div>

  <div class="base">
    <span>© {year} Lea Tămășiloniu</span>
  </div>
</footer>

<style>
  .footer-checker {
    --checker-b: var(--chocolate);
  }

  .site-footer {
    background: var(--chocolate);
    color: var(--blush);
    padding: 64px clamp(20px, 3.9vw, 56px) 36px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: clamp(64px, 10vw, 150px);
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .columns {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    border-top: 1px solid var(--blush);
    padding-top: 24px;
    font-size: 15px;
    line-height: 1.6;
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .col.end {
    align-items: flex-end;
    text-align: right;
  }

  .head {
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .caps {
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .avail {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .avail .dot {
    background: #7fb99c;
  }

  .initials {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .initials .serif {
    font-size: clamp(150px, 30vw, 430px);
    line-height: 0.74;
  }

  .bullet {
    flex-shrink: 0;
    width: clamp(32px, 6.4vw, 92px);
    height: clamp(32px, 6.4vw, 92px);
    border-radius: 50%;
    background: var(--blush);
  }

  .base {
    font-size: 13px;
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 40px;
    }

    .col.end {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 520px) {
    .columns {
      grid-template-columns: 1fr;
    }
  }
</style>
