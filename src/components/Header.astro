---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#practice', label: 'Practice' },
  { href: '/#about', label: 'About' },
];
---
<header class="site-header">
  <nav class="nav" aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a class="mark" href="/" aria-label="Lea Tămășiloniu, home">
    <img src="/monogram.svg" alt="" width="40" height="41" />
  </a>
  <div class="end">
    <a href="#contact">Contact</a>
  </div>
</header>

<style>
  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 110px;
    padding: 0 var(--gutter);
    font-size: 12px;
    letter-spacing: 0.26em;
    text-transform: uppercase;
  }

  .nav {
    display: flex;
    gap: 40px;
  }

  .mark img {
    width: 40px;
  }

  .end {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 720px) {
    .site-header {
      grid-template-columns: auto 1fr;
      height: 84px;
      font-size: 11px;
      letter-spacing: 0.18em;
    }

    .mark {
      grid-column: 1;
      grid-row: 1;
    }

    .mark img {
      width: 34px;
    }

    .nav {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      gap: 18px;
    }

    .end {
      display: none;
    }
  }
</style>
