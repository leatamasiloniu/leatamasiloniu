---
import Glyphs from '../components/Glyphs.astro';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { offers, services, path, other, pageTitle, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const copy = {
  en: {
    lead: 'The know-how behind work done well. I listen first, to the people, the space and the business, then build the structure that lets good work happen.',
    who: 'For studios, print and paper houses, hospitality and creative brands.',
    consultancy: 'Consultancy',
    consultancyLead: 'Four ways to work together, on their own or combined.',
    expertise: 'The expertise behind it',
    practice: 'The practice',
    practiceLead: 'Painting, drawing, interiors and photography keep my eye sharp. They are where the craft comes from.',
    practiceItems: [
      { a: 'Painting & drawing', b: 'Flowers and doodles', href: path('en', 'art') },
      { a: 'Illustration', b: 'The Whole World and His Dog' },
      { a: 'Interior design', b: 'BA (Hons), First Class, University of the Arts London' },
      { a: 'Photography', b: '' },
    ],
    description: 'Consultancy for creative businesses: operations reviews, systems and SOPs, projects and events, and ongoing support.',
  },
  ro: {
    lead: 'Priceperea din spatele lucrului bine făcut. Întâi ascult oamenii, spațiul și afacerea, apoi construiesc structura care face posibil un lucru bun.',
    who: 'Pentru studiouri, tipografii, afaceri din ospitalitate și branduri creative.',
    consultancy: 'Consultanță',
    consultancyLead: 'Patru moduri de a lucra împreună, separat sau combinate.',
    expertise: 'Experiența din spate',
    practice: 'Practica',
    practiceLead: 'Pictura, desenul, designul de interior și fotografia îmi țin ochiul exersat. De acolo vine atenția la detaliu.',
    practiceItems: [
      { a: 'Pictură și desen', b: 'Flori și desene libere', href: path('ro', 'art') },
      { a: 'Ilustrație', b: 'The Whole World and His Dog' },
      { a: 'Design de interior', b: 'BA (Hons), First Class, University of the Arts London' },
      { a: 'Fotografie', b: '' },
    ],
    description: 'Consultanță pentru afaceri creative: analiză operațională, sisteme și proceduri, proiecte și evenimente, sprijin continuu.',
  },
}[lang];
---
<Base lang={lang} alt={path(other(lang), 'savoir')} current="savoir" title={pageTitle('Savoir-Faire')} description={copy.description}>
  <section class="page-head">
    <h1 class="serif title"><Glyphs text="Savoir-Faire" /></h1>
    <p class="serif lead">{copy.lead}</p>
    <p class="label who">{copy.who}</p>
  </section>

  <section class="offers" aria-labelledby="offers-title">
    <div class="sec-head">
      <h2 id="offers-title" class="label">{copy.consultancy}</h2>
      <p class="serif sec-lead">{copy.consultancyLead}</p>
    </div>
    <div class="offer-grid">
      {offers[lang].map((o, i) => (
        <article class="offer">
          <span class="num serif" aria-hidden="true">0{i + 1}</span>
          <h3 class="serif"><Glyphs text={o.title} /></h3>
          <p class="o-body">{o.body}</p>
          <ul>
            {o.items.map((it) => <li>{it}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="expertise" aria-labelledby="exp-title">
    <h2 id="exp-title" class="label exp-label">{copy.expertise}</h2>
    {services[lang].map((s) => (
      <div class="discipline">
        <div class="d-main">
          <h3 class="serif">{s.title}</h3>
          <p class="d-body">{s.body}</p>
        </div>
        <ul class="d-list">
          {s.items.map((it) => <li>{it}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <section class="practice" aria-labelledby="practice-title">
    <h2 id="practice-title" class="label">{copy.practice}</h2>
    <p class="serif p-lead">{copy.practiceLead}</p>
    <ul class="p-list">
      {copy.practiceItems.map((it) => (
        <li>
          {it.href ? (
            <a class="p-link" href={it.href}>
              <span class="serif">{it.a}</span>
              <span class="p-note">{it.b} <span class="arrow" aria-hidden="true">→</span></span>
            </a>
          ) : (
            <div class="p-row">
              <span class="serif">{it.a}</span>
              {it.b && <span class="p-note">{it.b}</span>}
            </div>
          )}
        </li>
      ))}
    </ul>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .page-head {
    padding: clamp(48px, 7vw, 100px) var(--gutter) clamp(64px, 8vw, 120px);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .title {
    font-size: clamp(52px, 8vw, 120px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.3;
    max-width: 980px;
  }

  .who {
    color: var(--cocoa);
    line-height: 1.8;
  }

  .offers {
    background: var(--blush);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5vw, 72px);
  }

  .sec-head {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .sec-lead {
    font-style: italic;
    font-size: clamp(24px, 2.4vw, 34px);
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(48px, 5vw, 72px) clamp(32px, 5vw, 80px);
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .num {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--green);
    color: var(--milk);
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
    font-size: 24px;
  }

  .offer h3 {
    font-size: clamp(32px, 3vw, 44px);
    line-height: 1.05;
  }

  .o-body {
    font-weight: 300;
    line-height: 1.8;
    max-width: 520px;
  }

  .offer ul,
  .d-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .offer li {
    padding: 12px 0;
    border-bottom: 1px solid var(--line-blush);
    font-size: 15px;
  }

  .offer li:first-child {
    border-top: 1px solid var(--line-blush);
  }

  .expertise {
    padding: var(--section-y) var(--gutter) 0;
  }

  .exp-label {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .discipline {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 64px);
    padding: clamp(40px, 4vw, 56px) 0;
    border-top: 1px solid var(--line-milk);
  }

  .discipline:last-child {
    padding-bottom: var(--section-y);
  }

  .d-main {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .d-main h3 {
    font-size: clamp(34px, 3.4vw, 48px);
    line-height: 1;
  }

  .d-body {
    font-weight: 300;
    line-height: 1.8;
    max-width: 520px;
  }

  .d-list li {
    padding: 12px 0;
    border-bottom: 1px solid var(--line-milk);
    font-size: 15px;
  }

  .practice {
    background: var(--blush);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .p-lead {
    font-style: italic;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.3;
    max-width: 900px;
  }

  .p-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-blush);
  }

  .p-row,
  .p-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-blush);
  }

  .p-link {
    transition: padding 0.3s ease;
  }

  .p-link:hover {
    color: var(--chocolate);
    padding-left: 12px;
  }

  .p-list .serif {
    font-size: clamp(22px, 2vw, 30px);
  }

  .p-note {
    font-size: 14px;
    color: var(--cocoa);
    text-align: right;
  }

  .p-link .p-note {
    color: var(--chocolate);
  }

  @media (max-width: 900px) {
    .offer-grid,
    .discipline {
      grid-template-columns: 1fr;
    }

    .p-row,
    .p-link {
      flex-direction: column;
      gap: 6px;
    }

    .p-note {
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p-link {
      transition: none;
    }
  }
</style>
