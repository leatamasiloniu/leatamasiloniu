---
import Glyphs from '../components/Glyphs.astro';
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { ui, services, path, other, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const copy = {
  en: {
    lead: 'The know-how behind work done well. Three disciplines, one way of working: listen first, then build the structure that lets good work happen.',
    practice: 'The practice',
    practiceLead: 'Painting, drawing, interiors and photography keep the eye sharp — they’re where the craft comes from.',
    practiceItems: [
      ['Painting & drawing', ''],
      ['Illustration', 'The Whole World and His Dog'],
      ['Interior design', 'BA (Hons), First Class — University of the Arts London'],
      ['Photography', ''],
    ],
    description: 'Structure, delivery and craft: the three disciplines behind Lea Tămășiloniu Studio.',
  },
  ro: {
    lead: 'Priceperea din spatele lucrului bine făcut. Trei discipline, un singur mod de lucru: întâi ascult, apoi construiesc structura care face posibil un lucru bun.',
    practice: 'Practica',
    practiceLead: 'Pictura, desenul, designul de interior și fotografia îmi țin ochiul exersat — de acolo vine meșteșugul.',
    practiceItems: [
      ['Pictură și desen', ''],
      ['Ilustrație', 'The Whole World and His Dog'],
      ['Design de interior', 'BA (Hons), First Class — University of the Arts London'],
      ['Fotografie', ''],
    ],
    description: 'Structură, execuție și meșteșug: cele trei discipline din spatele Lea Tămășiloniu Studio.',
  },
}[lang];
---
<Base lang={lang} alt={path(other(lang), 'savoir')} current="savoir" title="Savoir-Faire — Lea Tămășiloniu" description={copy.description}>
  <section class="page-head">
    <h1 class="serif title"><Glyphs text="Savoir-Faire" /></h1>
    <p class="serif lead"><Glyphs text={copy.lead} /></p>
  </section>

  {services[lang].map((s, i) => (
    <section class="discipline">
      <span class="num serif" aria-hidden="true">0{i + 1}</span>
      <div class="d-main">
        <h2 class="serif">{s.title}</h2>
        <p class="d-body">{s.body}</p>
      </div>
      <ul class="d-list">
        {s.items.map((it) => <li>{it}</li>)}
      </ul>
    </section>
  ))}

  <section class="practice" aria-labelledby="practice-title">
    <h2 id="practice-title" class="label">{copy.practice}</h2>
    <p class="serif p-lead"><Glyphs text={copy.practiceLead} /></p>
    <ul class="p-list">
      {copy.practiceItems.map(([a, b]) => (
        <li><span class="serif">{a}</span>{b && <span class="p-note">{b}</span>}</li>
      ))}
    </ul>
  </section>

  <Cta lang={lang} />
</Base>

<style>
  .page-head {
    padding: clamp(48px, 7vw, 100px) var(--gutter) clamp(64px, 8vw, 120px);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .title {
    font-size: clamp(52px, 8vw, 120px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .lead {
    font-size: clamp(26px, 2.8vw, 40px);
    line-height: 1.3;
    max-width: 980px;
  }

  .discipline {
    display: grid;
    grid-template-columns: 80px minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 64px);
    padding: clamp(48px, 5vw, 72px) var(--gutter);
    border-top: 1px solid var(--line-milk);
  }

  .num {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--green);
    color: var(--milk);
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
    font-size: 24px;
  }

  .d-main {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .d-main h2 {
    font-size: clamp(38px, 4vw, 56px);
    line-height: 1;
  }

  .d-body {
    font-weight: 300;
    line-height: 1.8;
    max-width: 520px;
  }

  .d-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .d-list li {
    padding: 12px 0;
    border-bottom: 1px solid var(--line-milk);
    font-size: 15px;
  }

  .practice {
    background: var(--blush);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .p-lead {
    font-style: italic;
    font-size: clamp(28px, 3vw, 44px);
    line-height: 1.3;
    max-width: 900px;
  }

  .p-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-blush);
  }

  .p-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line-blush);
  }

  .p-list .serif {
    font-size: clamp(22px, 2vw, 30px);
  }

  .p-note {
    font-size: 14px;
    color: var(--cocoa);
    text-align: right;
  }

  @media (max-width: 900px) {
    .discipline {
      grid-template-columns: 1fr;
    }

    .p-list li {
      flex-direction: column;
      gap: 6px;
    }

    .p-note {
      text-align: left;
    }
  }
</style>
