---
import Glyphs from '../components/Glyphs.astro';
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import { ui, offers, path, projectPath, type Lang } from '../i18n/ui';
import { projects, yearLabel } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const alt = path(lang === 'en' ? 'ro' : 'en', 'home');
---
<Base lang={lang} alt={alt} current="home">
  <section class="hero">
    <div class="hero-centre">
      <img class="hero-mark" src="/monogram.svg" alt="" width="168" height="174" />
      <h1 class="serif">Lea Tămășiloniu</h1>
      <p class="label hero-line">{t.heroLine}</p>
    </div>
    <div class="hero-foot label">
      <span>{t.studio}</span>
      <span class="avail"><span class="dot" aria-hidden="true"></span>{t.available}</span>
    </div>
  </section>

  <div class="checker" aria-hidden="true"></div>

  <section class="statement">
    <p class="serif"><Glyphs text={t.statement} /> <em>{t.statementEm}</em></p>
    <p class="label sign"><span class="rule" aria-hidden="true"></span>Lea Tămășiloniu</p>
  </section>

  <section class="services" aria-labelledby="services-title">
    <div class="row-head">
      <h2 id="services-title" class="label">{t.howIHelp}</h2>
      <a class="label more" href={path(lang, 'savoir')}>{t.moreSavoir} <span aria-hidden="true">→</span></a>
    </div>
    <div class="service-grid">
      {offers[lang].map((s, i) => (
        <article class="service">
          <span class="num serif" aria-hidden="true">0{i + 1}</span>
          <h3 class="serif">{s.title}</h3>
          <p>{s.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="work" aria-labelledby="work-title">
    <div class="row-head">
      <h2 id="work-title" class="label">{t.selectedWork}</h2>
      <a class="label btn-frame" href={path(lang, 'work')}>{t.allWork}</a>
    </div>
    <ul class="work-list">
      {projects.map((p) => (
        <li>
          <a href={projectPath(lang, p.slug)}>
            <span class:list={['name', 'serif', { italic: p.italic }]}>
              {p.name.split(' × ').map((part, i) => (
                <>{i > 0 && <span class="glyph"> × </span>}{part}</>
              ))}
            </span>
            <span class="kind">{p[lang].kind}</span>
            <span class="year">{yearLabel(p, t.since)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Carousel lang={lang} />
</Base>

<style>
  .hero {
    min-height: min(calc(100svh - 110px), 902px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(40px, 8vh, 96px) var(--gutter) 48px;
    gap: 64px;
  }

  .hero-centre {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 4vw, 44px);
    text-align: center;
  }

  .hero-mark {
    width: clamp(110px, 12vw, 168px);
  }

  .hero h1 {
    font-size: clamp(40px, 7.2vw, 104px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-line {
    letter-spacing: 0.46em;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    letter-spacing: 0.26em;
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .statement {
    background: var(--blush);
    padding: clamp(96px, 14vw, 200px) clamp(20px, 16vw, 230px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .statement .serif {
    font-size: clamp(28px, 3.2vw, 46px);
    line-height: 1.32;
    letter-spacing: -0.005em;
  }

  .sign {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .rule {
    width: 48px;
    height: 1px;
    background: var(--chocolate);
  }

  .row-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .more {
    border-bottom: 1px solid var(--chocolate);
    padding-bottom: 6px;
  }

  .services {
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(48px, 5.5vw, 80px);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(40px, 5vw, 72px);
  }

  .service {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .num {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: var(--green);
    color: var(--milk);
    display: flex;
    align-items: center;
    justify-content: center;
    font-style: italic;
    font-size: 24px;
  }

  .service h3 {
    font-size: clamp(30px, 2.5vw, 36px);
    line-height: 1.05;
  }

  .service p {
    font-weight: 300;
    line-height: 1.85;
  }

  .work {
    background: var(--blush);
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .work-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line-blush);
  }

  .work-list a {
    display: grid;
    grid-template-columns: 7fr 4fr 1fr;
    align-items: baseline;
    gap: 16px;
    padding: 38px 0;
    border-top: 1px solid var(--line-blush);
    transition: padding 0.3s ease;
  }

  .work-list a:hover {
    color: var(--chocolate);
    padding-left: 12px;
  }

  .name {
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1.1;
  }

  .italic {
    font-style: italic;
  }

  .kind,
  .year {
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--cocoa);
  }

  .year {
    text-align: right;
    white-space: nowrap;
  }

  @media (max-width: 1100px) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .work-list a {
      grid-template-columns: 1fr auto;
      row-gap: 8px;
      padding: 28px 0;
    }

    .name {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      font-size: 11px;
      letter-spacing: 0.18em;
    }

    .hero-line {
      letter-spacing: 0.3em;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-list a {
      transition: none;
    }
  }
</style>
