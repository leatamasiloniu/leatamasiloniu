---
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import { ui, offers, path, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const alt = path(lang === 'en' ? 'ro' : 'en', 'home');
const roman = ['i.', 'ii.', 'iii.', 'iv.'];

// Written in Lea's voice, after her portfolio: "When designing, one must listen first."
const statement = {
  en: ['Every business has its own rhythm', 'I listen first, to the people, the space and the story behind it', 'then build the structure that lets it flow. Care, observation and a little razzmatazz', 'always with an eye for quality.'],
  ro: ['Fiecare afacere are ritmul ei', 'Întâi ascult oamenii, spațiul și povestea din spatele ei', 'apoi construiesc structura care o lasă să curgă. Grijă, atenție și un strop de razzmatazz', 'mereu cu un ochi atent la calitate.'],
}[lang];

const copy = {
  en: {
    help: 'How I can help',
    helpLead: 'Most businesses don’t need more work. They need a clearer way of working.',
    work: 'Selected work',
  },
  ro: {
    help: 'Cum te pot ajuta',
    helpLead: 'Majoritatea afacerilor nu au nevoie de mai multă muncă. Au nevoie de un mod mai clar de a lucra.',
    work: 'Proiecte selectate',
  },
}[lang];
---
<Base lang={lang} alt={alt} current="home">
  <section class="hero">
    <div class="hero-centre">
      <img class="hero-mark" src="/monogram.svg" alt="" width="168" height="174" />
      <h1 class="serif">Lea Tămășiloniu</h1>
      <p class="label hero-line">{t.heroLine}</p>
    </div>
    <div class="hero-foot label">
      <span>{t.studio}</span>
      <span class="avail"><span class="dot" aria-hidden="true"></span>{t.available}</span>
    </div>
  </section>

  <div class="checker" aria-hidden="true"></div>

  <section class="statement" data-reveal>
    <blockquote>
      <p class="serif">{statement[0]}. {statement[1]}, {statement[2]}, <em>{statement[3]}</em></p>
    </blockquote>
    <p class="label sign"><span class="rule" aria-hidden="true"></span>Lea Tămășiloniu</p>
  </section>

  <section class="help" aria-labelledby="help-title">
    <div class="help-head" data-reveal>
      <h2 id="help-title" class="serif sec-title">{copy.help}</h2>
      <p class="help-lead">{copy.helpLead}</p>
    </div>
    <ol class="offer-list">
      {offers[lang].map((o, i) => (
        <li data-reveal>
          <span class="idx serif" aria-hidden="true">{roman[i]}</span>
          <h3 class="serif">{o.title}</h3>
          <p>{o.body}</p>
        </li>
      ))}
    </ol>
    <a class="more" href={path(lang, 'savoir')}>{t.moreSavoir} <span aria-hidden="true">→</span></a>
  </section>

  <Carousel lang={lang} title={copy.work} moreHref={path(lang, 'work')} moreLabel={t.allWork} />

</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    min-height: min(calc(100svh - 110px), 902px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(40px, 8vh, 96px) var(--gutter) 48px;
    gap: 64px;
  }

  .hero-centre {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(28px, 4vw, 44px);
    text-align: center;
  }

  .hero-mark {
    width: clamp(110px, 12vw, 168px);
  }

  .hero h1 {
    font-size: clamp(40px, 7.2vw, 104px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .hero-line {
    letter-spacing: 0.46em;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    letter-spacing: 0.26em;
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  /* ---------- Statement (a quote, signed) ---------- */
  .statement {
    background: var(--blush);
    padding: clamp(96px, 14vw, 200px) clamp(20px, 16vw, 230px);
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .statement blockquote {
    margin: 0;
  }

  .statement .serif {
    font-size: clamp(28px, 3.2vw, 46px);
    line-height: 1.32;
    letter-spacing: -0.005em;
  }

  .sign {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .rule {
    width: 48px;
    height: 1px;
    background: var(--chocolate);
  }

  /* ---------- How I can help ---------- */
  .help {
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .help-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px;
    align-items: end;
  }

  .sec-title {
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .help-lead {
    font-weight: 300;
    font-size: 18px;
    line-height: 1.7;
    max-width: 480px;
  }

  .offer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line-milk);
  }

  .offer-list li {
    display: grid;
    grid-template-columns: 64px minmax(0, 5fr) minmax(0, 6fr);
    gap: 24px 40px;
    align-items: baseline;
    padding: clamp(26px, 3vw, 40px) 0;
    border-top: 1px solid var(--line-milk);
  }

  .idx {
    font-style: italic;
    font-size: 22px;
    color: var(--green);
  }

  .offer-list h3 {
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.05;
    transition: transform 0.35s ease;
  }

  .offer-list li:hover h3 {
    transform: translateX(10px);
  }

  .offer-list p {
    font-weight: 300;
    line-height: 1.8;
    max-width: 520px;
  }

  .more {
    align-self: flex-start;
    font-size: 15px;
    border-bottom: 1px solid var(--chocolate);
    padding-bottom: 4px;
  }

  @media (max-width: 900px) {
    .help-head {
      grid-template-columns: 1fr;
    }

    .offer-list li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .offer-list p {
      grid-column: 2;
    }
  }

  @media (max-width: 560px) {
    .hero-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      font-size: 11px;
      letter-spacing: 0.18em;
    }

    .hero-line {
      letter-spacing: 0.3em;
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .offer-list h3 {
      transition: none;
    }
  }
</style>
