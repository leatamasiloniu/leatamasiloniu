---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Carousel from '../components/Carousel.astro';
import { ui, offers, path, type Lang } from '../i18n/ui';
import { flowers, doodles } from '../data/art';
import tiles from '../assets/work/tiles.jpg';
import lobby from '../assets/work/watchhouse/lobby-1.jpg';
import bouquet from '../assets/art/bouquet.jpg';
import ranunculus from '../assets/art/ranunculus.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const alt = path(lang === 'en' ? 'ro' : 'en', 'home');
const roman = ['i.', 'ii.', 'iii.', 'iv.'];

// Written in Lea's voice, after her portfolio: "When designing, one must listen first."
const statement = {
  en: ['Every business has its own rhythm', 'I listen first, to the people, the space and the story behind it', 'then build the structure that lets it flow. Care, observation and a little razzmatazz', 'always with an eye for quality.'],
  ro: ['Fiecare afacere are ritmul ei', 'Întâi ascult oamenii, spațiul și povestea din spatele ei', 'apoi construiesc structura care o lasă să curgă. Grijă, atenție și un strop de razzmatazz', 'mereu cu un ochi atent la calitate.'],
}[lang];

const copy = {
  en: {
    help: 'How I can help',
    helpLead: 'Most businesses don’t need more work. They need a clearer way of working.',
    work: 'Selected work',
    practice: 'Where the eye comes from',
    practiceLead: 'Painting and drawing keep my eye sharp. The same attention goes into every business I work with.',
    practiceLink: 'Painting & drawing',
  },
  ro: {
    help: 'Cum te pot ajuta',
    helpLead: 'Majoritatea afacerilor nu au nevoie de mai multă muncă. Au nevoie de un mod mai clar de a lucra.',
    work: 'Proiecte selectate',
    practice: 'De unde vine ochiul',
    practiceLead: 'Pictura și desenul îmi țin ochiul exersat. Aceeași atenție o aduc în fiecare afacere cu care lucrez.',
    practiceLink: 'Pictură și desen',
  },
}[lang];

const teaser = [flowers[2], doodles[1], flowers[0]];
---
<Base lang={lang} alt={alt} current="home">
  <section class="hero">
    <p class="hero-top">
      <span>{t.studio}</span>
      <span class="avail"><span class="dot" aria-hidden="true"></span>{t.available}</span>
    </p>

    <h1 class="hero-name serif">
      <span class="l1">
        <span class="word">Lea</span>
        <span class="arch" aria-hidden="true">
          <Image src={bouquet} alt="" widths={[300, 500, 700]} sizes="(max-width: 700px) 30vw, 22vw" loading="eager" />
        </span>
      </span>
      <span class="l2">Tămășiloniu</span>
    </h1>

    <div class="hero-foot">
      <p class="hero-line serif">{t.heroLine}.</p>
      <a class="hero-cta" href={path(lang, 'contact')}>{t.cta.a} <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <div class="checker" aria-hidden="true"></div>

  <section class="statement" data-reveal>
    <p class="serif">
      {statement[0]}<span class="pill" aria-hidden="true"><Image src={tiles} alt="" widths={[160, 320]} sizes="120px" /></span>{'. '}{statement[1]}<span class="pill" aria-hidden="true"><Image src={lobby} alt="" widths={[160, 320]} sizes="120px" /></span>{', '}{statement[2]}<span class="pill" aria-hidden="true"><Image src={ranunculus} alt="" widths={[160, 320]} sizes="120px" /></span>{', '}<em>{statement[3]}</em>
    </p>
  </section>

  <section class="help" aria-labelledby="help-title">
    <div class="help-head" data-reveal>
      <h2 id="help-title" class="serif sec-title">{copy.help}</h2>
      <p class="help-lead">{copy.helpLead}</p>
    </div>
    <ol class="offer-list">
      {offers[lang].map((o, i) => (
        <li data-reveal>
          <span class="idx serif" aria-hidden="true">{roman[i]}</span>
          <h3 class="serif">{o.title}</h3>
          <p>{o.body}</p>
        </li>
      ))}
    </ol>
    <a class="more" href={path(lang, 'savoir')}>{t.moreSavoir} <span aria-hidden="true">→</span></a>
  </section>

  <Carousel lang={lang} title={copy.work} moreHref={path(lang, 'work')} moreLabel={t.allWork} />

  <section class="practice" aria-labelledby="practice-title">
    <div class="p-text" data-reveal>
      <h2 id="practice-title" class="serif sec-title">{copy.practice}</h2>
      <p>{copy.practiceLead}</p>
      <a class="more" href={path(lang, 'art')}>{copy.practiceLink} <span aria-hidden="true">→</span></a>
    </div>
    <a class="p-images" href={path(lang, 'art')} aria-label={copy.practiceLink}>
      {teaser.map((a, i) => (
        <span class:list={['p-img', `p-img-${i}`]} data-reveal>
          <Image src={a.image} alt="" widths={[300, 500, 800]} sizes="(max-width: 700px) 45vw, 22vw" />
        </span>
      ))}
    </a>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    min-height: min(calc(100svh - 110px), 940px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(28px, 4vw, 56px);
    padding: clamp(12px, 2vw, 24px) var(--gutter) clamp(36px, 5vw, 64px);
  }

  .hero-top {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    letter-spacing: 0.04em;
    border-top: 1px solid var(--line-milk);
    padding-top: 16px;
  }

  .avail {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    font-size: min(14.2vw, 232px);
    line-height: 0.86;
    letter-spacing: -0.035em;
  }

  .l1 {
    display: flex;
    align-items: flex-end;
    gap: 0.12em;
  }

  .arch {
    display: block;
    width: 0.62em;
    height: 0.8em;
    margin-bottom: 0.06em;
    border-radius: 999px 999px 0 0;
    overflow: hidden;
    background: var(--blush);
  }

  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .l2 {
    padding-left: 0.5em;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    flex-wrap: wrap;
  }

  .hero-line {
    font-style: italic;
    font-size: clamp(24px, 2.6vw, 38px);
    line-height: 1.15;
  }

  .hero-cta {
    font-size: 15px;
    border-bottom: 1px solid var(--chocolate);
    padding-bottom: 4px;
  }

  /* ---------- Statement with inline images ---------- */
  .statement {
    background: var(--blush);
    padding: clamp(88px, 12vw, 180px) var(--gutter);
  }

  .statement p {
    font-size: clamp(30px, 4.1vw, 60px);
    line-height: 1.22;
    letter-spacing: -0.01em;
    max-width: 1180px;
  }

  .pill {
    display: inline-block;
    width: 1.7em;
    height: 0.82em;
    margin: 0 0.04em 0 0.2em;
    border-radius: 999px;
    overflow: hidden;
    vertical-align: -0.08em;
    background: var(--line-blush);
  }

  .pill :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- How I can help ---------- */
  .help {
    padding: var(--section-y) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  .help-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 40px;
    align-items: end;
  }

  .sec-title {
    font-size: clamp(40px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .help-lead {
    font-weight: 300;
    font-size: 18px;
    line-height: 1.7;
    max-width: 480px;
  }

  .offer-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line-milk);
  }

  .offer-list li {
    display: grid;
    grid-template-columns: 64px minmax(0, 5fr) minmax(0, 6fr);
    gap: 24px 40px;
    align-items: baseline;
    padding: clamp(26px, 3vw, 40px) 0;
    border-top: 1px solid var(--line-milk);
  }

  .idx {
    font-style: italic;
    font-size: 22px;
    color: var(--green);
  }

  .offer-list h3 {
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1.05;
    transition: transform 0.35s ease;
  }

  .offer-list li:hover h3 {
    transform: translateX(10px);
  }

  .offer-list p {
    font-weight: 300;
    line-height: 1.8;
    max-width: 520px;
  }

  .more {
    align-self: flex-start;
    font-size: 15px;
    border-bottom: 1px solid var(--chocolate);
    padding-bottom: 4px;
  }

  /* ---------- Practice teaser ---------- */
  .practice {
    background: var(--blush);
    padding: var(--section-y) var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  .p-text {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .p-text p {
    font-weight: 300;
    font-size: 18px;
    line-height: 1.7;
    max-width: 420px;
  }

  .p-images {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 28px);
    align-items: start;
  }

  .p-img {
    display: block;
    transition: transform 0.4s ease;
  }

  .p-img :global(img) {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .p-img-1 {
    margin-top: clamp(40px, 6vw, 96px);
  }

  .p-img-2 {
    margin-top: clamp(16px, 2.5vw, 40px);
  }

  .p-images:hover .p-img {
    transform: translateY(-6px);
  }

  @media (max-width: 900px) {
    .help-head,
    .practice {
      grid-template-columns: 1fr;
    }

    .offer-list li {
      grid-template-columns: 40px minmax(0, 1fr);
    }

    .offer-list p {
      grid-column: 2;
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: auto;
      gap: 56px;
      padding-bottom: 48px;
    }

    .hero-top {
      flex-direction: column;
      gap: 8px;
      font-size: 12px;
    }

    .hero-name {
      font-size: 15.6vw;
    }

    .l2 {
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .offer-list h3,
    .p-img {
      transition: none;
    }
  }
</style>
