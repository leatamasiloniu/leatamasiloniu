---
import Glyphs from '../components/Glyphs.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { ui, path, projectPath, other, type Lang } from '../i18n/ui';
import { projects, type Project } from '../data/projects';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project: p } = Astro.props;
const t = ui[lang];
const c = p[lang];
const idx = projects.findIndex((x) => x.slug === p.slug);
const nextP = projects[(idx + 1) % projects.length];
---
<Base
  lang={lang}
  alt={projectPath(other(lang), p.slug)}
  current="work"
  title={`${p.name} — Lea Tămășiloniu`}
  description={c.intro}
>
  <article>
    <header class="head">
      <a class="label back" href={path(lang, 'work')}><span aria-hidden="true">←</span> {t.nav.work}</a>
      <h1 class:list={['serif', { italic: p.italic }]}><Glyphs text={p.name} /></h1>
      <p class="kind serif">{c.kind}</p>
      <dl class="meta">
        <div><dt class="label">{t.project.client}</dt><dd>{p.client}</dd></div>
        <div><dt class="label">{t.project.role}</dt><dd>{c.role}</dd></div>
        <div><dt class="label">{t.project.year}</dt><dd>{p.year}</dd></div>
      </dl>
    </header>

    {p.image && (
      <figure class="visual">
        <Image src={p.image} alt={p.alt?.[lang] ?? ''} widths={[640, 960, 1280, 1600]} sizes="(max-width: 900px) 100vw, 60vw" loading="eager" />
      </figure>
    )}

    {p.image && (
      <section class="palette" aria-label={t.project.palette}>
        <p class="label">{t.project.palette}</p>
        <ul>
          {p.palette.swatches.map((s) => (
            <li><span class="chip" style={`background:${s}`}></span><span class="hex">{s}</span></li>
          ))}
        </ul>
      </section>
    )}

    <section class="body">
      <p class="intro serif"><Glyphs text={c.intro} /></p>
      {c.points.length > 0 && (
        <ul class="points">
          {c.points.map((pt) => <li>{pt}</li>)}
        </ul>
      )}
      {p.soon && <p class="soon">{t.project.soon}</p>}
    </section>

    <a class="next" href={projectPath(lang, nextP.slug)}>
      <span class="label">{t.project.next}</span>
      <span class:list={['serif', 'next-name', { italic: nextP.italic }]}><Glyphs text={nextP.name} /> <span class="glyph" aria-hidden="true">→</span></span>
    </a>
  </article>
</Base>

<style>
  .head {
    padding: clamp(40px, 6vw, 88px) var(--gutter) clamp(40px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .back {
    margin-bottom: clamp(20px, 3vw, 40px);
  }

  h1 {
    font-size: clamp(44px, 7vw, 104px);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .italic {
    font-style: italic;
  }

  .kind {
    font-style: italic;
    font-size: clamp(22px, 2.2vw, 30px);
    color: var(--cocoa);
  }

  .meta {
    margin: clamp(24px, 3vw, 40px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    border-top: 1px solid var(--line-milk);
    padding-top: 22px;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  dd {
    margin: 0;
    font-size: 16px;
  }

  .visual {
    margin: 0;
    padding: 0 var(--gutter);
  }

  .visual :global(img) {
    width: 100%;
    max-height: 88vh;
    object-fit: cover;
  }

  .palette {
    padding: 28px var(--gutter) 0;
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
  }

  .palette ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  .palette li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.08em;
  }

  .chip {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(74, 50, 40, 0.12);
  }

  .body {
    padding: var(--section-y) var(--gutter);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 40px;
  }

  .intro {
    grid-column: 1 / span 6;
    font-size: clamp(26px, 2.6vw, 38px);
    line-height: 1.3;
  }

  .points,
  .soon {
    grid-column: 8 / -1;
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-milk);
  }

  .points li {
    padding: 18px 0;
    border-bottom: 1px solid var(--line-milk);
    font-weight: 300;
    line-height: 1.7;
  }

  .soon {
    font-style: italic;
    color: var(--cocoa);
    align-self: end;
  }

  .next {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: clamp(64px, 8vw, 120px) var(--gutter);
    background: var(--blush);
  }

  .next-name {
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1.05;
  }

  .next:hover .next-name {
    color: var(--cocoa);
  }

  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }

    .intro,
    .points,
    .soon {
      grid-column: 1 / -1;
    }

    .meta {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
